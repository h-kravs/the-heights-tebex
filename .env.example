# ─── Tebex Headless API ──────────────────────────────────────────────
# Public token of the webstore (Tebex Creator Panel → Integrations → Headless API).
# It is public by design: it ships in the client bundle, exactly like on a
# Tebex-hosted store. NEVER put the private key here.
#
# With this empty the site runs in DEMO MODE with a sample catalog.
# Copy this file to `.env` and fill it in. `.env` is gitignored, this one is not.
VITE_TEBEX_TOKEN=

# Your Tebex store domain, no trailing slash. Used as a checkout fallback
# if the Tebex overlay fails to load.
VITE_TEBEX_STORE_URL=https://theheightsla.tebex.io

# ─── Server links ───────────────────────────────────────────────────
VITE_DISCORD_URL=https://discord.gg/theheightsla
# Direct connect: fivem://connect/<ip or cfx.re/join/<code>>
VITE_CONNECT_URL=fivem://connect/cfx.re/join/theheights

# ─── Live stats (server-side only, no VITE_ prefix) ──────────────────
# Read by the /api/server-stats proxy. Both are public identifiers, not secrets.
# Cfx join code: bare code or a full https://cfx.re/join/… URL.
FIVEM_SERVER_CODE=
# Discord invite code: bare code or a full discord.gg/… URL.
DISCORD_INVITE_CODE=
